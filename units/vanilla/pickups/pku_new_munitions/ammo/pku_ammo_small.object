<dynamic_object>
	<diesel orientation_object="rp_ammo_small" materials="units/vanilla/pickups/pku_new_munitions/ammo/pku_ammo" />
	<sequence_manager file="units/vanilla/pickups/pku_new_munitions/pku_new_munitions" />
	
    <animations>
        <animation_group name="anim_spawn" enabled="false">
            <object name="anim_ammo_small_spawn" />
        </animation_group>
    </animations>

	<bodies>
        <body name="static_body" enabled="true" template="editor">
            <object name="c_ammo_small" collision_type="box" />
        </body>
    </bodies>
	
	<effects>
		<effect_spawner name="beam" object="int_ammo_small_top" effect="units/vanilla/pickups/pku_new_munitions/ammo/pku_ammo_beam_weak" enabled="false" />
	</effects>
	
	<graphics>
		<object name="g_ammo_small"			 enabled="true" shadow_caster="true" />
		<object name="g_ammo_small_glow"	instance_struct="world_tm" enabled="true" />
	</graphics>
</dynamic_object>
