<dynamic_object>
    <diesel orientation_object="rp_grenade_stack" materials="units/vanilla/pickups/pku_new_munitions/grenades/pku_grenade_stack" />
    <sequence_manager file="units/vanilla/pickups/pku_new_munitions/pku_new_munitions" />
	
    <animations>
        <animation_group name="anim_spawn" enabled="false">
            <object name="anim_grenade_spawn_1" />
            <object name="anim_grenade_spawn_2" />
            <object name="anim_grenade_spawn_3" />
            <object name="anim_grenade_spawn_4" />
        </animation_group>
    </animations>

