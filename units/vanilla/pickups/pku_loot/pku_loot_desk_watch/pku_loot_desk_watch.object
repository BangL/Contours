<dynamic_object>
    <diesel orientation_object="rp_pku_desk_watch" materials="units/vanilla/pickups/pku_loot/pku_loot_desk_watch/pku_loot_desk_watch" />
    <sequence_manager file="units/vanilla/pickups/pku_loot/pku_loot_desk_watch/pku_loot_desk_watch" />
    <bodies>
        <body enabled="true" template="static" name="static_body">
            <object name="rp_pku_desk_watch" />
            <object name="c_box" collision_type="box" padding="-2.5" />
        </body>
    </bodies>
    <decal_surfaces>
        <decal_mesh name="dm_metal" enabled="true" material="metal" />
    </decal_surfaces>
    <graphics>
        <object name="g_watch" enabled="true" />
        <object name="g_effect" instance_struct="world_tm" enabled="true" />
        <object name="s_watch"  instance_struct="world_tm" enabled="true" shadow_caster="true" />
    </graphics>
</dynamic_object>
